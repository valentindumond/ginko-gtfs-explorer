extends layout 

block content 
    each route in routes
        details(style=`color: #${route.text_color}; background-color: #${route.color}`)
            summary #{route.short_name} - #{route.name}
            ul.lines 
                each direction, index in route.directions 
                    li(data-route=`${route.id}`, data-direction=`${index}`) Direction <em>#{direction}</em>