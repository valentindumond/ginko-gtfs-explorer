doctype html
html
  head
    title Lignes du réseau Ginko
    link(rel="stylesheet",href="style.css")
  body
    h1 Lignes du réseau Ginko 
    each route in routes
        details(style=`color: #${route.text_color}; background-color: #${route.color}`)
            summary #{route.short_name} - #{route.name}
            ul 
                each direction in route.directions 
                    li Direction <em>#{direction}</em>