doctype html 
html
    head
        title Stations du réseau Ginko 
        link(rel="stylesheet", href="style.css")
    body 
        header
            h1 Noms des stations du réseau
            nav
                span ≡
                a(href="/lignes") Lignes
                a(href="/stations") Stations
        ul 
            each station in stations
                li #{station.name}